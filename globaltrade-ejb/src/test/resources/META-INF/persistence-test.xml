<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="GlobalTradePU" transaction-type="JTA">
        <!-- WildFly's built-in H2 database -->
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>
        
        <class>com.globaltrade.core.entity.Customer</class>
        <class>com.globaltrade.core.entity.Inventory</class>
        <class>com.globaltrade.core.entity.Order</class>
        <class>com.globaltrade.core.entity.OrderItem</class>
        <class>com.globaltrade.core.entity.Vendor</class>
        <class>com.globaltrade.core.entity.SupplierOrder</class>
        <class>com.globaltrade.core.entity.Shipment</class>
        <class>com.globaltrade.core.entity.CustomsDeclaration</class>
        <class>com.globaltrade.core.entity.CustomsAuditLog</class>
        <class>com.globaltrade.core.entity.SupplierEvaluation</class>

        <properties>
            <!-- Drop and create tables before/after tests in H2 -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
